# Environment variables for the project

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
export LOG_LEVEL=DEBUG

# Lunch Money API key (https://my.lunchmoney.app/developers)
export LUNCH_MONEY_API_KEY=

# Universal AI API key (works for any provider, Google Gemini is the default)
# export AMAZON_LUNCHMONEY_AI_KEY=
# export AMAZON_LUNCHMONEY_MODEL=google:gemini-3.8-flash

# Or configure provider-specific keys directly:
# export GOOGLE_API_KEY=
# export OPENAI_API_KEY=
# export ANTHROPIC_API_KEY=
